#!/usr/bin/env bash

set -euo pipefail

# Define variables
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ $# -gt 1 ]]; then
    echo "Usage: $0 [profile]" >&2
    echo "Default profile: home" >&2
    exit 2
fi
PROFILE="${1:-home}"
ENV_FILE="${BASEDIR}/.env"
CUSTOM_ENV_FILE="${BASEDIR}/.env.${PROFILE}"
CONFIG_FILE="${BASEDIR}/install.conf.yaml"
TEMPLATE_FILE="${BASEDIR}/install.conf.template.yaml"
DIR_DOTBOT="dotbot"
DIR_COMPLETE_ALIAS="complete-alias"
DOTBOT_BIN="bin/dotbot"

# Load default (minimal) environment
if [[ -f "$ENV_FILE" ]]; then
    echo "Loading default environment"
    set -a
    # shellcheck disable=SC1090
    source "$ENV_FILE"
    set +a
fi

# Load profile-specific environment
if [[ -f "$CUSTOM_ENV_FILE" ]]; then
    echo "Loading profile: $PROFILE"
    set -a
    # shellcheck disable=SC1090
    source "$CUSTOM_ENV_FILE"
    set +a
else
    echo "Error: profile-specific environment not found: $CUSTOM_ENV_FILE" >&2
    exit 2
fi

# Ensure the GITCONFIG_FILE variable is defined
GITCONFIG_FILE=".gitconfig.${PROFILE}"
if [[ ! -f "${BASEDIR}/${GITCONFIG_FILE}" ]]; then
    echo "Profile-specific .gitconfig not found. Using default."
    GITCONFIG_FILE=".gitconfig.default"
fi
export GITCONFIG_FILE="${GITCONFIG_FILE}"

if ! command -v envsubst >/dev/null 2>&1; then
    echo "Error: envsubst not found (needed to render install.conf.yaml from the template)." >&2
    echo "Install gettext-base (Debian/Ubuntu: sudo apt install gettext-base) or gettext (macOS: brew install gettext)." >&2
    exit 1
fi
envsubst < "$TEMPLATE_FILE" > "$CONFIG_FILE"

# Install custom aliases
echo "Installing custom aliases..."
cd "${BASEDIR}"
git -C "${DIR_COMPLETE_ALIAS}" submodule sync --quiet --recursive
git submodule update --init --recursive "${DIR_COMPLETE_ALIAS}"

# Combine aliases into a single completion file
cat "${DIR_COMPLETE_ALIAS}/complete_alias" my-complete-alias > .bash_completion

# Function to remove a regular file if it exists and is not a symlink
remove_regular_file() {
    local file="$1"
    if [[ -f "$file" && ! -L "$file" ]]; then
        echo "Removing regular file: $file"
        rm -f "$file"
    fi
}

# List of files to check
files_to_remove=("$HOME/.bashrc" "$HOME/.profile" "$HOME/.bash_logout" "$HOME/.ssh/config")

# Loop through each file and call the function
for file in "${files_to_remove[@]}"; do
    remove_regular_file "$file"
done

# Initialize Dotbot submodule
echo "Initializing Dotbot submodule..."
cd "${BASEDIR}"
git -C "${DIR_DOTBOT}" submodule sync --quiet --recursive
git submodule update --init --recursive "${DIR_DOTBOT}"

# Run Dotbot
echo "Running Dotbot..."
"${BASEDIR}/${DIR_DOTBOT}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG_FILE}"

# Install Starship if necessary. With no starship.toml, Starship uses its built-in default prompt.
if ! command -v starship >/dev/null 2>&1; then
    echo "Installing Starship..."
    curl -fsSL https://starship.rs/install.sh | sh -s -- --bin-dir ~/.local/bin -y
fi

# Compare archive release metadata, not fontconfig's cache or the upstream font version.
# Latest-release lookup and installation failures are nonfatal.
install_nerd_font_if_outdated() {
    local font_family_query="JetBrainsMono Nerd Font"
    local font_dir="${HOME}/.local/share/fonts/NerdFonts/JetBrainsMono"
    local releases_url="https://github.com/ryanoasis/nerd-fonts/releases"
    local installed_release="" latest_url release zip_url tmp_dir
    local release_pattern='^https://github\.com/ryanoasis/nerd-fonts/releases/tag/(v[0-9]+\.[0-9]+\.[0-9]+)$'
    local metadata_pattern='s/^This is an archived font from the Nerd Fonts release (v[0-9]+\.[0-9]+\.[0-9]+)\.$/\1/p'

    if [[ -f "${font_dir}/README.md" ]] && compgen -G "${font_dir}/*.ttf" >/dev/null 2>&1; then
        installed_release="$(sed -nE "${metadata_pattern}" "${font_dir}/README.md")"
    fi
    if ! command -v curl >/dev/null 2>&1; then
        echo "Warning: curl missing; skipping Nerd Font update check." >&2
        return 0
    fi
    if ! latest_url="$(curl -fsSL --connect-timeout 5 --max-time 20 \
        -o /dev/null -w '%{url_effective}' "${releases_url}/latest")" \
        || [[ ! "${latest_url}" =~ $release_pattern ]]; then
        echo "Warning: could not determine latest Nerd Font release; leaving installed fonts unchanged." >&2
        return 0
    fi
    release="${BASH_REMATCH[1]}"
    if [[ "${installed_release}" == "${release}" ]]; then
        echo "Nerd Font already at latest release (${font_family_query}, ${release})."
        return 0
    fi
    if ! command -v unzip >/dev/null 2>&1; then
        echo "Warning: unzip missing; skipping Nerd Font install." >&2
        return 0
    fi

    zip_url="${releases_url}/download/${release}/JetBrainsMono.zip"
    echo "Installing ${font_family_query} (${release}) for Starship icons..."
    if ! tmp_dir="$(mktemp -d "${TMPDIR:-/tmp}/JetBrainsMono-XXXXXX")"; then
        echo "Warning: could not create temporary Nerd Font directory; continuing." >&2
        return 0
    fi
    if ! curl -fsSL --connect-timeout 5 --max-time 120 -o "${tmp_dir}/font.zip" "${zip_url}"; then
        echo "Warning: failed to download Nerd Font from ${zip_url}; continuing." >&2
        rm -rf "${tmp_dir}"
        return 0
    fi
    if ! unzip -q "${tmp_dir}/font.zip" -d "${tmp_dir}/fonts"; then
        echo "Warning: failed to extract Nerd Font archive; continuing." >&2
        rm -rf "${tmp_dir}"
        return 0
    fi
    if [[ ! -f "${tmp_dir}/fonts/README.md" ]] \
        || ! compgen -G "${tmp_dir}/fonts/*.ttf" >/dev/null 2>&1 \
        || [[ "$(sed -nE "${metadata_pattern}" "${tmp_dir}/fonts/README.md")" != "${release}" ]]; then
        echo "Warning: Nerd Font archive has missing or mismatched release metadata/fonts; continuing." >&2
        rm -rf "${tmp_dir}"
        return 0
    fi
    # Publish the release metadata last so failed copies remain eligible for retry.
    if ! mv "${tmp_dir}/fonts/README.md" "${tmp_dir}/README.md" \
        || ! mkdir -p "${font_dir}" \
        || ! cp -R "${tmp_dir}/fonts/." "${font_dir}/" \
        || ! cp "${tmp_dir}/README.md" "${font_dir}/README.md"; then
        echo "Warning: failed to install Nerd Font files; continuing." >&2
        rm -rf "${tmp_dir}"
        return 0
    fi
    rm -rf "${tmp_dir}"
    if command -v fc-cache >/dev/null 2>&1; then
        fc-cache -f "${HOME}/.local/share/fonts" >/dev/null 2>&1 || true
    fi
    echo "Nerd Font installed under ${font_dir}."
    echo "Point your terminal font at '${font_family_query}' (or another Nerd Font) if icons still show as missing glyphs."
}

install_nerd_font_if_outdated

echo "Dotfiles setup complete!"
